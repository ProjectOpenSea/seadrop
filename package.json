{
  "name": "seadrop",
  "version": "1.0.0",
  "private": true,
  "description": "Primary drops on the evm.",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "coverage": "FOUNDRY_PROFILE=coverage forge coverage --report summary --report lcov --no-match-coverage 'Shim|MaliciousRecipient|Deploy|Test|Snapshot'",
    "lint": "forge fmt --check && forge lint --deny warnings && biome ci .",
    "lint:fix": "forge fmt && biome check --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "lefthook": "2.2.2"
  }
}
