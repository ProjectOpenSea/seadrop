{
  "name": "seadrop",
  "version": "2.0.0",
  "private": true,
  "description": "Primary drops on the evm.",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "./scripts/build_seaport.sh && forge build && ./scripts/show_headroom.sh",
    "build:seaport": "./scripts/build_seaport.sh",
    "test": "forge test",
    "lint": "forge fmt --check && ./scripts/patch_seaport_pragmas.sh && forge lint --deny warnings && biome ci .",
    "lint:fix": "forge fmt && biome check --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "lefthook": "2.2.2"
  }
}
